# Copy to backend/.env and fill in the values from your Supabase project.
# Project settings > Data API gives the URL; Project settings > API keys gives
# the service-role key. The service-role key is server-side only: never put it
# in the React app or commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed by `python -m scripts.init_db`, which creates the users table.
# From the dashboard: Connect > Session pooler. Use your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Sign the access tokens returned by /auth/login with a long random value.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=1440

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
